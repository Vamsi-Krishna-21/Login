# Backend API URL for Vite Frontend
# Local development: Vite dev server defaults to http://localhost:5000 (and proxies /api)
VITE_API_URL=http://localhost:5000

# Production deployment (e.g. Vercel): Set this in Vercel project environment variables to your deployed backend URL:
# VITE_API_URL=https://your-backend-api.onrender.com
